
from datetime import datetime, timezone
from uuid import uuid4

from fastapi import FastAPI, HTTPException
from pydantic import BaseModel, Field
from sqlalchemy import select
from sqlalchemy.exc import SQLAlchemyError

from database import Base, SessionLocal, check_database_connection, engine
from models import EmergencyEvent

app = FastAPI(
    title="AEGIS API",
    description="Emergency Safety and Alert System",
    version="0.1.0",
)


@app.on_event("startup")
def initialize_database():
    Base.metadata.create_all(bind=engine)


class SOSRequest(BaseModel):
    device_id: str = Field(min_length=1, max_length=100)
    idempotency_key: str = Field(min_length=1, max_length=64)
    trigger_source: str = Field(default="manual", pattern="^manual$")


@app.get("/")
def home():
    return {
        "app": "AEGIS",
        "message": "AEGIS backend is running",
        "status": "online",
    }


@app.get("/health")
def health_check():
    return {
        "status": "healthy",
        "timestamp": datetime.now(timezone.utc).isoformat(),
    }


@app.get("/health/database")
def database_health():
    try:
        check_database_connection()
        return {"database": "connected", "status": "healthy"}
    except SQLAlchemyError:
        raise HTTPException(status_code=503, detail="Database connection failed")


@app.post("/api/emergencies", status_code=201)
def create_emergency(request: SOSRequest):
    try:
        with SessionLocal() as db:
            existing = db.scalar(
                select(EmergencyEvent).where(
                    EmergencyEvent.idempotency_key == request.idempotency_key
                )
            )

            if existing:
                return {
                    "event_id": existing.id,
                    "status": existing.status,
                    "message": "Emergency event already exists",
                }

            event = EmergencyEvent(
                idempotency_key=request.idempotency_key,
                device_id=request.device_id,
                trigger_source=request.trigger_source,
                status="active",
            )

            db.add(event)
            db.commit()
            db.refresh(event)

            return {
                "event_id": event.id,
                "status": event.status,
                "message": "Emergency event created",
            }

    except SQLAlchemyError:
        raise HTTPException(
            status_code=503,
            detail="Could not save the emergency event",
        )


@app.get("/api/emergencies/{event_id}")
def get_emergency(event_id: str):
    with SessionLocal() as db:
        event = db.get(EmergencyEvent, event_id)

        if event is None:
            raise HTTPException(status_code=404, detail="Emergency event not found")

        return {
            "event_id": event.id,
            "device_id": event.device_id,
            "trigger_source": event.trigger_source,
            "status": event.status,
            "created_at": event.created_at,
        }
