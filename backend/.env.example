# AEGIS Backend Environment Configuration Example
# Copy this file to .env and adjust values for your environment.

# PostgreSQL Connection String
DATABASE_URL=postgresql+psycopg://username:password@localhost:5432/aegis_db

# Self-Hosted LiveKit Server Settings
# Use ws://<laptop-lan-ip>:7880 for Android devices on the local Wi-Fi network.
LIVEKIT_URL=ws://192.168.1.4:7880
LIVEKIT_API_KEY=aegis_key
LIVEKIT_API_SECRET=aegis_dev_secret_key_for_livekit_safety_calling_32b

# Firebase Cloud Messaging (Phase 6 Incoming Call Push)
# Place service-account JSON in backend/ and reference relative to backend directory:
FIREBASE_CREDENTIALS_PATH=serviceAccountKey.json
